# Merged over the architecture's defconfig by build-kernel.sh.
#
# Everything here is BUILT IN (=y), never a module: the guest agent is the
# init, so nothing has loaded a module by the time it opens its vsock socket.

# The agent's only channel to the executor.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y

# Firecracker and QEMU's microvm/virt machines present virtio over MMIO; PCI is
# kept too so the same image boots a machine model that puts virtio on PCI.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_PCI=y
CONFIG_PCI=y

# The rootfs is a gzipped cpio initramfs, and the agent mounts /dev itself.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
