{
  "name": "Issue triage",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "parameters": { "path": "issue-opened", "httpMethod": "POST" },
      "id": "6b1f8f52-1b0e-4a35-9a7f-6d2a1c8a5e11",
      "name": "Issue webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-120, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "title", "value": "={{ $json[\"issue\"][\"title\"] }}" },
            {
              "name": "reporter",
              "value": "={{ $json[\"issue\"][\"user\"][\"login\"] }}"
            }
          ]
        }
      },
      "id": "b0a4a1d1-0a53-4a5f-9a02-0f5f9f3d6e22",
      "name": "Normalise issue",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [100, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json[\"title\"] }}",
              "operation": "contains",
              "value2": "bug"
            }
          ]
        }
      },
      "id": "2c9b6ad8-5f1c-49a9-9d0a-3c8b0d2f7e33",
      "name": "Is bug",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [320, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://tracker.example.test/api/tickets",
        "sendBody": true
      },
      "id": "8f2d1c44-9b7e-4f0b-8a6e-1b2c3d4e5f44",
      "name": "Create ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "retryOnFail": true,
      "position": [560, 200]
    },
    {
      "parameters": { "channel": "#triage", "text": "={{ $json[\"title\"] }}" },
      "id": "d4e5f6a7-b8c9-4d0e-9f1a-2b3c4d5e6f55",
      "name": "Notify triage",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [800, 300]
    }
  ],
  "connections": {
    "Issue webhook": {
      "main": [[{ "node": "Normalise issue", "type": "main", "index": 0 }]]
    },
    "Normalise issue": {
      "main": [[{ "node": "Is bug", "type": "main", "index": 0 }]]
    },
    "Is bug": {
      "main": [
        [{ "node": "Create ticket", "type": "main", "index": 0 }],
        [{ "node": "Notify triage", "type": "main", "index": 0 }]
      ]
    },
    "Create ticket": {
      "main": [[{ "node": "Notify triage", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {
    "Issue webhook": [
      { "json": { "issue": { "title": "bug: crash on start" } } }
    ]
  }
}
